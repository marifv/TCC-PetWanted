{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node scripts/configure-api-env.js && expo start",
    "android": "node scripts/configure-api-env.js && expo start --android",
    "ios": "node scripts/configure-api-env.js && expo start --ios",
    "web": "node scripts/configure-api-env.js && expo start --web",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-firebase/app": "^23.8.6",
    "@react-native-firebase/messaging": "^23.8.6",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "~57.0.27",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.0",
    "socket.io-client": "^4.8.1"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.js",
      "**/*.test.jsx"
    ]
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.2.10",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  }
